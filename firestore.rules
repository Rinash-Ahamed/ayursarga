rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveProfile() {
      return isSignedIn()
        && getCurrentUser().uid == request.auth.uid
        && getCurrentUser().status == 'active';
    }

    function isAdmin() {
      return hasActiveProfile()
        && getCurrentUser().role == 'admin';
    }

    function isHospital() {
      return hasActiveProfile()
        && getCurrentUser().role == 'hospital'
        && getCurrentUser().hospitalId != null;
    }

    function isConsumer() {
      return hasActiveProfile() && getCurrentUser().role == 'consumer';
    }

    function belongsToHospital(hospitalId) {
      return isHospital() && getCurrentUser().hospitalId == hospitalId;
    }

    function hasOperationalHospitalAccess(hospitalId) {
      return belongsToHospital(hospitalId)
        && get(/databases/$(database)/documents/hospitals/$(hospitalId)).data.status != 'archived';
    }

    function isDocumentOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isApprovedHospital(hospitalId) {
      let hospital = get(/databases/$(database)/documents/hospitals/$(hospitalId)).data;
      return hospital.status == 'active' && hospital.isPublic == true;
    }

    function hasExactUserFields() {
      return request.resource.data.keys().hasOnly([
        'uid', 'name', 'email', 'phone', 'address', 'role', 'status', 'hospitalId',
        'privacyConsentAt', 'privacyConsentVersion',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
        'archivedAt', 'archivedBy', 'lastAuditId'
      ]);
    }

    function hasExactHospitalFields() {
      return request.resource.data.keys().hasOnly([
        'name', 'description', 'email', 'phone', 'address', 'city', 'state',
        'imageUrl', 'imageUrls', 'ayursargaRating', 'ayursargaReviewNote',
        'centreGuidelines', 'additionalCentreRules', 'facilities', 'legalPolicies', 'locationUrl',
        'status', 'isPublic', 'commissionPercentage',
        'contractStatus', 'contractGeneratedAt', 'contractGeneratedBy',
        'contractSignedAt', 'contractSignedBy', 'contractUrl', 'activatedAt', 'activatedBy',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
        'archivedAt', 'archivedBy', 'lastAuditId'
      ]);
    }

    function hasValidCentreGuidelines() {
      let guidelines = request.resource.data.get('centreGuidelines', {});
      let additionalRules = request.resource.data.get('additionalCentreRules', '');
      let facilities = request.resource.data.get('facilities', '');
      let legalPolicies = request.resource.data.get('legalPolicies', '');
      return guidelines is map
        && guidelines.keys().hasOnly([
          'visitors', 'quietEnvironment', 'foodAndBeverages', 'prohibitedActivities',
          'privacyAndPhotography', 'cleanliness', 'propertyDamage', 'ayurvedicTherapies',
          'medicationsAndCharges', 'reportConcerns', 'emergencySituations'
        ])
        && guidelines.get('visitors', '') is string && guidelines.get('visitors', '').size() <= 1200
        && guidelines.get('quietEnvironment', '') is string && guidelines.get('quietEnvironment', '').size() <= 1200
        && guidelines.get('foodAndBeverages', '') is string && guidelines.get('foodAndBeverages', '').size() <= 1200
        && guidelines.get('prohibitedActivities', '') is string && guidelines.get('prohibitedActivities', '').size() <= 1200
        && guidelines.get('privacyAndPhotography', '') is string && guidelines.get('privacyAndPhotography', '').size() <= 1200
        && guidelines.get('cleanliness', '') is string && guidelines.get('cleanliness', '').size() <= 1200
        && guidelines.get('propertyDamage', '') is string && guidelines.get('propertyDamage', '').size() <= 1200
        && guidelines.get('ayurvedicTherapies', '') is string && guidelines.get('ayurvedicTherapies', '').size() <= 1200
        && guidelines.get('medicationsAndCharges', '') is string && guidelines.get('medicationsAndCharges', '').size() <= 1200
        && guidelines.get('reportConcerns', '') is string && guidelines.get('reportConcerns', '').size() <= 1200
        && guidelines.get('emergencySituations', '') is string && guidelines.get('emergencySituations', '').size() <= 1200
        && additionalRules is string
        && additionalRules.size() <= 4000
        && facilities is string
        && facilities.size() <= 4000
        && legalPolicies is string
        && legalPolicies.size() <= 4000;
    }

    function hasValidHospitalProfileFields() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 25
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 10
        && request.resource.data.address.size() <= 300
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && request.resource.data.state is string
        && request.resource.data.state.size() >= 2
        && request.resource.data.state.size() <= 80
        && (!request.resource.data.keys().hasAny(['imageUrls']) || (
          request.resource.data.imageUrls is list
          && request.resource.data.imageUrls.size() <= 4
          && (request.resource.data.imageUrls.size() < 1 || (
            request.resource.data.imageUrls[0] is string
            && request.resource.data.imageUrls[0].size() <= 500
            && request.resource.data.imageUrls[0].matches('https://.+')
          ))
          && (request.resource.data.imageUrls.size() < 2 || (
            request.resource.data.imageUrls[1] is string
            && request.resource.data.imageUrls[1].size() <= 500
            && request.resource.data.imageUrls[1].matches('https://.+')
          ))
          && (request.resource.data.imageUrls.size() < 3 || (
            request.resource.data.imageUrls[2] is string
            && request.resource.data.imageUrls[2].size() <= 500
            && request.resource.data.imageUrls[2].matches('https://.+')
          ))
          && (request.resource.data.imageUrls.size() < 4 || (
            request.resource.data.imageUrls[3] is string
            && request.resource.data.imageUrls[3].size() <= 500
            && request.resource.data.imageUrls[3].matches('https://.+')
          ))
        ))
        && (request.resource.data.get('locationUrl', null) == null || (
          request.resource.data.locationUrl is string
          && request.resource.data.locationUrl.size() <= 500
          && request.resource.data.locationUrl.matches('https://(maps\\.app\\.goo\\.gl|maps\\.google\\.com|maps\\.google\\.co\\.in|goo\\.gl|www\\.google\\.com|www\\.google\\.co\\.in|www\\.openstreetmap\\.org|openstreetmap\\.org)/.*')
        ))
        && hasValidCentreGuidelines();
    }

    function hasValidRequiredHospitalFields() {
      return hasValidHospitalProfileFields()
        && (request.resource.data.get('imageUrl', null) == null
          || request.resource.data.get('imageUrl', null) is string)
        && (request.resource.data.get('ayursargaRating', null) == null || (
          request.resource.data.ayursargaRating is number
          && request.resource.data.ayursargaRating >= 1
          && request.resource.data.ayursargaRating <= 5
        ))
        && (request.resource.data.get('ayursargaReviewNote', null) == null || (
          request.resource.data.ayursargaReviewNote is string
          && request.resource.data.ayursargaReviewNote.size() <= 400
        ))
        && request.resource.data.commissionPercentage is number
        && request.resource.data.commissionPercentage >= 0
        && request.resource.data.commissionPercentage <= 100;
    }

    function hasValidServiceFields() {
      let durationMinutes = request.resource.data.durationMinutes;
      let durationUnit = request.resource.data.get('durationUnit', null);
      return request.resource.data.keys().hasOnly([
          'hospitalId', 'name', 'description', 'price', 'durationMinutes', 'durationUnit', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'archivedAt', 'archivedBy', 'lastAuditId'
        ])
        && request.resource.data.hospitalId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && (durationMinutes == null || (durationMinutes is int && durationMinutes > 0))
        && (durationUnit == null || durationUnit in ['minutes', 'hours', 'days'])
        && request.resource.data.status in ['active', 'inactive', 'archived'];
    }

    function isBootstrapAdminIdentity() {
      return isSignedIn() && request.auth.token.email == 'info@ayursarga.com';
    }

    function isAuditedModule(module) {
      return module in ['users', 'hospitals', 'services', 'bookings', 'hospitalCapacity'];
    }

    function hasLinkedAudit(module, recordId) {
      let auditId = request.resource.data.lastAuditId;
      let audit = getAfter(/databases/$(database)/documents/auditLogs/$(auditId)).data;
      return auditId is string
        && audit.module == module
        && audit.recordId == recordId
        && audit.actorId == request.auth.uid
        && audit.actorRole == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        && audit.action in ['create', 'update', 'archive', 'restore', 'status_change',
          'contract_generated', 'contract_signed', 'hospital_activated']
        && audit.timestamp == request.time
        && audit.updatedValues.lastAuditId == auditId;
    }

    function hasCreateAudit(module, recordId) {
      let audit = getAfter(/databases/$(database)/documents/auditLogs/$(request.resource.data.lastAuditId)).data;
      return hasLinkedAudit(module, recordId) && audit.action == 'create';
    }

    function linkedAuditAction() {
      return getAfter(/databases/$(database)/documents/auditLogs/$(request.resource.data.lastAuditId)).data.action;
    }

    function validAdminHospitalUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let action = linkedAuditAction();
      return (action == 'update'
          && changed.hasOnly([
            'name', 'description', 'email', 'phone', 'address', 'city', 'state',
            'imageUrl', 'imageUrls', 'ayursargaRating', 'ayursargaReviewNote',
            'centreGuidelines', 'additionalCentreRules', 'facilities', 'legalPolicies', 'locationUrl',
            'commissionPercentage', 'updatedAt', 'updatedBy', 'lastAuditId'
          ])
          && (!changed.hasAny(['ayursargaRating', 'ayursargaReviewNote']) || (
            resource.data.status == 'active'
            && request.resource.data.status == 'active'
          )))
        || (action == 'status_change'
          && resource.data.status == 'active'
          && request.resource.data.status == 'inactive'
          && request.resource.data.isPublic == false
          && changed.hasOnly(['status', 'isPublic', 'updatedAt', 'updatedBy', 'lastAuditId']))
        || (action == 'contract_generated'
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.contractStatus in ['generated', 'signed']
          && request.resource.data.contractGeneratedAt == request.time
          && request.resource.data.contractGeneratedBy == request.auth.uid
          && changed.hasOnly([
            'contractStatus', 'contractGeneratedAt', 'contractGeneratedBy',
            'contractSignedAt', 'contractSignedBy', 'contractUrl', 'activatedAt', 'activatedBy',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ]))
        || (action == 'contract_signed'
          && resource.data.status == 'pending'
          && resource.data.contractStatus == 'generated'
          && request.resource.data.status == 'pending'
          && request.resource.data.contractStatus == 'signed'
          && request.resource.data.contractSignedAt == request.time
          && request.resource.data.contractSignedBy == request.auth.uid
          && changed.hasOnly([
            'contractStatus', 'contractSignedAt', 'contractSignedBy',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ]))
        || (action == 'hospital_activated'
          && resource.data.status in ['pending', 'inactive']
          && resource.data.contractStatus == 'signed'
          && resource.data.contractSignedAt != null
          && request.resource.data.status == 'active'
          && request.resource.data.isPublic == true
          && request.resource.data.contractStatus == 'signed'
          && request.resource.data.contractUrl is string
          && request.resource.data.contractUrl.size() > 8
          && request.resource.data.contractUrl.size() <= 500
          && request.resource.data.contractUrl.matches('https?://.+')
          && request.resource.data.activatedAt == request.time
          && request.resource.data.activatedBy == request.auth.uid
          && changed.hasOnly([
            'status', 'isPublic', 'contractUrl', 'activatedAt', 'activatedBy',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ]))
        || (action == 'archive'
          && request.resource.data.status == 'archived'
          && request.resource.data.isPublic == false
          && changed.hasOnly([
            'status', 'isPublic', 'archivedAt', 'archivedBy',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ]))
        || (action == 'restore'
          && resource.data.status == 'archived'
          && request.resource.data.status == 'inactive'
          && request.resource.data.isPublic == false
          && changed.hasOnly([
            'status', 'isPublic', 'archivedAt', 'archivedBy',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ]));
    }

    function validHospitalBookingTransition() {
      return (resource.data.status == 'requested'
          && request.resource.data.status in ['confirmed', 'reschedule_requested', 'rejected'])
        || (resource.data.status == 'reschedule_requested'
          && request.resource.data.status in ['confirmed', 'rejected'])
        || (resource.data.status == 'confirmed'
          && request.resource.data.status == 'reschedule_requested');
    }

    function validHospitalTreatmentTransition() {
      let previous = resource.data.get('treatmentStatus', 'not_started');
      let next = request.resource.data.treatmentStatus;
      return resource.data.status == 'confirmed'
        && ((previous == 'not_started'
            && next == 'started'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.treatmentStartedAt == request.time)
          || (previous == 'started'
            && next == 'ongoing'
            && request.resource.data.status == 'confirmed')
          || (previous in ['started', 'ongoing']
            && next == 'completed'
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time
            && request.resource.data.treatmentCompletedAt == request.time));
    }

    match /users/{userId} {
      allow read: if isAdmin() || isDocumentOwner(userId);
      allow create: if isDocumentOwner(userId)
        && hasExactUserFields()
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.phone == null || request.resource.data.phone is string)
        && (request.resource.data.address == null || request.resource.data.address is string)
        && request.resource.data.status == 'active'
        && request.resource.data.hospitalId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.archivedAt == null
        && request.resource.data.archivedBy == null
        && hasCreateAudit('users', userId)
        && (
          (request.resource.data.role == 'consumer'
            && request.auth.token.firebase.sign_in_provider == 'google.com')
          || (isBootstrapAdminIdentity() && request.resource.data.role == 'admin')
        );
      allow update: if hasLinkedAudit('users', userId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (isAdmin() || (
          isDocumentOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'address', 'privacyConsentAt', 'privacyConsentVersion',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ])
          && request.resource.data.name is string
          && (request.resource.data.phone == null || request.resource.data.phone is string)
          && (request.resource.data.address == null || request.resource.data.address is string)
          && (resource.data.role != 'consumer' || (
            request.resource.data.phone is string
            && request.resource.data.phone.size() >= 7
            && request.resource.data.phone.size() <= 25
            && (request.resource.data.address == null || (
              request.resource.data.address is string
              && request.resource.data.address.size() <= 300
            ))
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'privacyConsentAt', 'privacyConsentVersion'
              ])
              || (
                request.resource.data.privacyConsentAt == request.time
                && request.resource.data.privacyConsentVersion == '2026-09-01'
              )
            )
          ))
        ));
      allow delete: if false;
    }

    match /hospitals/{hospitalId} {
      allow read: if isAdmin()
        || hasOperationalHospitalAccess(hospitalId)
        || (resource.data.status == 'active' && resource.data.isPublic == true);
      allow create: if isAdmin()
        && hasExactHospitalFields()
        && hasValidRequiredHospitalFields()
        && request.resource.data.status == 'pending'
        && request.resource.data.isPublic == false
        && request.resource.data.contractStatus == 'not_generated'
        && request.resource.data.contractGeneratedAt == null
        && request.resource.data.contractGeneratedBy == null
        && request.resource.data.contractSignedAt == null
        && request.resource.data.contractSignedBy == null
        && request.resource.data.contractUrl == null
        && request.resource.data.activatedAt == null
        && request.resource.data.activatedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.archivedAt == null
        && request.resource.data.archivedBy == null
        && hasCreateAudit('hospitals', hospitalId);
      allow update: if hasLinkedAudit('hospitals', hospitalId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && ((isAdmin()
          && hasValidRequiredHospitalFields()
          && validAdminHospitalUpdate()) || (
          hasOperationalHospitalAccess(hospitalId)
          && hasValidHospitalProfileFields()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'email', 'phone', 'address', 'city', 'state',
            'imageUrls', 'centreGuidelines', 'additionalCentreRules', 'facilities', 'legalPolicies', 'locationUrl',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ])
        ));
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if isAdmin()
        || hasOperationalHospitalAccess(resource.data.hospitalId)
        || (resource.data.status == 'active' && isApprovedHospital(resource.data.hospitalId));
      allow create: if (isAdmin() || hasOperationalHospitalAccess(request.resource.data.hospitalId))
        && hasValidServiceFields()
        && ((request.resource.data.durationMinutes == null
            && request.resource.data.get('durationUnit', null) == null)
          || (request.resource.data.durationMinutes != null
            && request.resource.data.get('durationUnit', null) != null))
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.archivedAt == null
        && request.resource.data.archivedBy == null
        && hasCreateAudit('services', serviceId);
      allow update: if hasLinkedAudit('services', serviceId)
        && hasValidServiceFields()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (isAdmin() || (
          hasOperationalHospitalAccess(resource.data.hospitalId)
          && request.resource.data.hospitalId == resource.data.hospitalId
        ));
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isConsumer() && resource.data.consumerId == request.auth.uid)
        || hasOperationalHospitalAccess(resource.data.hospitalId);

      allow create: if isConsumer()
        && request.resource.data.keys().hasOnly([
          'consumerId', 'consumerName', 'consumerEmail', 'consumerPhone',
          'consumerAddress', 'hospitalId', 'serviceId', 'preferredDate', 'preferredEndDate',
          'preferredTime', 'bystanderCount',
          'confirmedDate', 'confirmedTime', 'status', 'servicePrice',
          'commissionPercentage', 'estimatedCommission', 'consumerNotes',
          'hospitalNotes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'archivedAt', 'archivedBy', 'lastAuditId', 'confirmedAt', 'completedAt',
          'treatmentStatus', 'treatmentStartedAt', 'treatmentCompletedAt'
        ])
        && request.resource.data.consumerId == request.auth.uid
        && request.resource.data.consumerName == getCurrentUser().name
        && request.resource.data.consumerEmail == getCurrentUser().email
        && request.resource.data.consumerPhone == getCurrentUser().phone
        && request.resource.data.consumerPhone is string
        && request.resource.data.consumerPhone.size() >= 7
        && request.resource.data.consumerPhone.size() <= 25
        && request.resource.data.consumerAddress == getCurrentUser().address
        && (request.resource.data.consumerAddress == null || (
          request.resource.data.consumerAddress is string
          && request.resource.data.consumerAddress.size() <= 300
        ))
        && request.resource.data.preferredDate is timestamp
        && (request.resource.data.preferredEndDate == null || (
          request.resource.data.preferredEndDate is timestamp
          && request.resource.data.preferredEndDate >= request.resource.data.preferredDate
        ))
        && request.resource.data.preferredTime is string
        && request.resource.data.preferredTime.size() > 0
        && request.resource.data.preferredTime.size() <= 20
        && request.resource.data.bystanderCount is int
        && request.resource.data.bystanderCount >= 0
        && request.resource.data.bystanderCount <= 4
        && request.resource.data.status == 'requested'
        && request.resource.data.confirmedDate == null
        && request.resource.data.confirmedTime == null
        && request.resource.data.hospitalNotes == null
        && request.resource.data.confirmedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.treatmentStatus == 'not_started'
        && request.resource.data.treatmentStartedAt == null
        && request.resource.data.treatmentCompletedAt == null
        && isApprovedHospital(request.resource.data.hospitalId)
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.hospitalId
          == request.resource.data.hospitalId
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.status
          == 'active'
        && request.resource.data.servicePrice
          == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.price
        && request.resource.data.commissionPercentage
          == get(/databases/$(database)/documents/hospitals/$(request.resource.data.hospitalId)).data.commissionPercentage
        && request.resource.data.estimatedCommission
          == request.resource.data.servicePrice * request.resource.data.commissionPercentage / 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.archivedAt == null
        && request.resource.data.archivedBy == null
        && hasCreateAudit('bookings', bookingId);

      allow update: if hasLinkedAudit('bookings', bookingId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (isAdmin()
        || (isConsumer()
          && resource.data.consumerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'updatedBy', 'lastAuditId'
          ])
          && resource.data.status in ['requested', 'confirmed', 'reschedule_requested']
          && resource.data.get('treatmentStatus', 'not_started') == 'not_started'
          && request.resource.data.status == 'cancelled'
        )
        || (hasOperationalHospitalAccess(resource.data.hospitalId)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'confirmedDate', 'confirmedTime', 'hospitalNotes',
              'confirmedAt', 'updatedAt', 'updatedBy', 'lastAuditId'
            ])
            && validHospitalBookingTransition()
            && (request.resource.data.status != 'confirmed'
              || (request.resource.data.confirmedDate != null
                && request.resource.data.confirmedTime != null
                && request.resource.data.confirmedAt == request.time)))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'treatmentStatus', 'treatmentStartedAt',
              'completedAt', 'treatmentCompletedAt',
              'updatedAt', 'updatedBy', 'lastAuditId'
            ])
            && validHospitalTreatmentTransition()))));
      allow delete: if false;
    }

    match /hospitalCapacity/{hospitalId} {
      allow read: if isAdmin() || hasOperationalHospitalAccess(hospitalId);
      allow create: if hasOperationalHospitalAccess(hospitalId)
        && request.resource.data.keys().hasOnly([
          'hospitalId', 'totalRooms', 'occupiedRooms', 'status',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'archivedAt', 'archivedBy', 'lastAuditId'
        ])
        && request.resource.data.hospitalId == hospitalId
        && request.resource.data.totalRooms is int
        && request.resource.data.totalRooms >= 0
        && request.resource.data.totalRooms <= 10000
        && request.resource.data.occupiedRooms is int
        && request.resource.data.occupiedRooms >= 0
        && request.resource.data.occupiedRooms <= request.resource.data.totalRooms
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.archivedAt == null
        && request.resource.data.archivedBy == null
        && hasCreateAudit('hospitalCapacity', hospitalId);
      allow update: if hasOperationalHospitalAccess(hospitalId)
        && hasLinkedAudit('hospitalCapacity', hospitalId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalRooms', 'occupiedRooms', 'updatedAt', 'updatedBy', 'lastAuditId'
        ])
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.status == 'active'
        && request.resource.data.totalRooms is int
        && request.resource.data.totalRooms >= 0
        && request.resource.data.totalRooms <= 10000
        && request.resource.data.occupiedRooms is int
        && request.resource.data.occupiedRooms >= 0
        && request.resource.data.occupiedRooms <= request.resource.data.totalRooms
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'action', 'module', 'recordId', 'actorId', 'actorRole',
          'previousValues', 'updatedValues', 'timestamp', 'source', 'device'
        ])
        && isAuditedModule(request.resource.data.module)
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole
          == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        && request.resource.data.action in ['create', 'update', 'archive', 'restore', 'status_change',
          'contract_generated', 'contract_signed', 'hospital_activated']
        && request.resource.data.recordId is string
        && (request.resource.data.previousValues == null
          || request.resource.data.previousValues is map)
        && request.resource.data.updatedValues is map
        && request.resource.data.updatedValues.lastAuditId == auditId
        && request.resource.data.timestamp == request.time
        && request.resource.data.source == 'web'
        && request.resource.data.device is map
        && request.resource.data.device.ipAddress == null
        && getAfter(/databases/$(database)/documents/$(request.resource.data.module)/$(request.resource.data.recordId)).data.lastAuditId
          == auditId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
