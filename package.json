{
  "name": "ayursarga",
  "version": "4.26.5",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config=tests/config/playwright.config.ts",
    "test:e2e:responsive": "playwright test --config=tests/config/playwright.config.ts tests/e2e/responsive.spec.ts",
    "test:e2e:dialogs": "playwright test --config=tests/config/playwright.dialogs.config.ts",
    "test:e2e:toasts": "playwright test --config=tests/config/playwright.toasts.config.ts",
    "test:e2e:centre-search": "playwright test --config=tests/config/playwright.centre-search.config.ts",
    "test:e2e:comparison": "playwright test --config=tests/config/playwright.comparison.config.ts",
    "test:e2e:consumer-bookings": "playwright test --config=tests/config/playwright.consumer-bookings.config.ts",
    "test:e2e:navigation": "playwright test --config=tests/config/playwright.navigation.config.ts",
    "test:e2e:performance": "playwright test --config=tests/config/playwright.performance.config.ts",
    "test:e2e:portal-ui": "playwright test --config=tests/config/playwright.portal-ui.config.ts",
    "test:e2e:search-performance": "playwright test --config=tests/config/playwright.search-performance.config.ts",
    "test:e2e:ayu": "playwright test --config=tests/config/playwright.ayu.config.ts",
    "firebase:emulators": "firebase emulators:start --project demo-ayursarga --only auth,firestore,hosting",
    "firebase:emulators:auth": "firebase emulators:start --project demo-ayursarga --only auth",
    "firebase:provision-user": "node scripts/provision-portal-user.mjs",
    "firebase:deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "firebase-tools": "^15.25.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
