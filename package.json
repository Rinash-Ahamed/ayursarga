{
  "name": "ayursarga",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "firebase:emulators": "firebase emulators:start --project demo-ayursarga --only auth,firestore,hosting",
    "firebase:emulators:auth": "firebase emulators:start --project demo-ayursarga --only auth",
    "firebase:test:auth": "firebase emulators:exec --project demo-ayursarga --only auth \"node scripts/verify-auth-emulator.mjs\"",
    "firebase:test:rules": "firebase emulators:exec --project demo-ayursarga --only auth,firestore \"node scripts/verify-firestore-rules.mjs\"",
    "firebase:provision-user": "node scripts/provision-portal-user.mjs",
    "firebase:deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "firebase-tools": "^15.25.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
