# Gmail or Google Workspace mailbox used for enquiries and branded auth emails.
GMAIL_USER=info@ayursarga.com

# A 16-character Google App Password - never use the normal Gmail password.
GMAIL_APP_PASSWORD=your_google_app_password

# Inbox that receives contact-form enquiries.
CONTACT_TO_EMAIL=info@ayursarga.com

# Canonical public website URL for password setup/reset return links.
# Add its domain to Firebase Authentication > Settings > Authorized domains.
# Server-only; do not derive email destinations from request headers.
APP_SITE_URL=https://www.ayursarga.com

# Firebase Web SDK configuration. These values identify the Firebase project
# and are safe to expose through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

# Trusted server only (required on Vercel for Hospital account provisioning).
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

# Server-only Firebase Storage bucket name, from Firebase Console > Storage.
# Use the actual bucket name without gs:// (older buckets may end in appspot.com).
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
