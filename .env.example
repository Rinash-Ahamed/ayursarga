# Gmail or Google Workspace mailbox used to send website enquiries.
GMAIL_USER=info@ayursarga.com

# A 16-character Google App Password - never use the normal Gmail password.
GMAIL_APP_PASSWORD=your_google_app_password

# Inbox that receives contact-form enquiries.
CONTACT_TO_EMAIL=info@ayursarga.com

# Firebase Web SDK configuration. These values identify the Firebase project
# and are safe to expose through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

# Firebase Admin uses Application Default Credentials on the server. For local
# development, point this variable to a securely stored service-account file.
# Never place the JSON key itself in this repository or expose it as NEXT_PUBLIC_*.
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_STORAGE_BUCKET=your-project.firebasestorage.app
